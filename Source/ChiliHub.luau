		local function makeRemoteFn(param)
			local slot
			local netPkg = NetworkingPackage
			local rfEggWorld = netPkg:FindFirstChild("RF/EggWorld/AskHatch")
			if rfEggWorld then
				if not (rfEggWorld:IsA("RemoteFunction")) then return false end
			else
				return false
			end
			local ok,invoke=pcall(rfEggWorld.InvokeServer,rfEggWorld,param)
			if ok then
				if invoke==false then return false end
			else
				return false
			end
			task.wait(0.35)
			netPkg = NetworkingPackage
			rfEggWorld = netPkg:FindFirstChild("RF/EggWorld/AskFinishHatch")
			if rfEggWorld then if rfEggWorld:IsA("RemoteFunction") then pcall(rfEggWorld.InvokeServer,rfEggWorld,param) end end
			return true
		end
		local flag2 = false
		local function refreshFocusedEggModal()
			local focus = resp and resp.Focus
			local isTable = type(focus)~="table"
			if isTable then
				return
			else
				local isId = focus.Id==nil
				if isId then
					return
				else
					local flag = flag2
					if flag then return end
				end
			end
			flag2 = true
			local strVal = tostring(focus.Id)
			pcall(function()
				local isStatusTxt = focus.Status=="Inventory"
				if isStatusTxt then
					local slot
					local mods = GameModules
					local eggState = mods.EggState
					if type(eggState)=="table" then
						if type(eggState.WearEggTool)=="function" then if pcall(eggState.WearEggTool,strVal) then return end end
					end
					local slot
					eggState = NetworkingPackage
					mods = eggState:FindFirstChild("RF/EggWorld/AskWearTool")
					if mods then if mods:IsA("RemoteFunction") then pcall(mods.InvokeServer,mods,strVal) end end
					return
				end
				if focus.Status=="Ready" then
					makeRemoteFn(strVal)
					return
				end
				local slot
				local hub,typeVal=HubState,type(HubState.FlyTo)
				if typeVal~="function" then return end
				isStatusTxt = workspace:FindFirstChild("PlacedEggRenders")
				local model
				if isStatusTxt then
					local ipairsFn,packed=ipairs,table.pack(isStatusTxt:GetChildren())
					for idx,nameRef in ipairsFn(table.unpack(packed,1,packed.n)) do
						if string.find(nameRef.Name,strVal,1,true) or nameRef:GetAttribute("Uid")==strVal then
							model = nameRef
							break
						end
					end
				else end
				if not model then return end
				typeVal,isStatusTxt=pcall(function() return model:IsA("Model") and model:GetPivot() or model.CFrame end)
				if not typeVal then return end
				typeVal = HubState
				local move = typeVal.Movement
				typeVal = move.Owner~=nil and move.Owner~="treadmill"
				if typeVal then
					return
				else
					local placeWanted = move.PlaceWanted
					if placeWanted then
						return
					else
						local hub = HubState
						local active = hub.Steal.Active
						if active then
							return
						else
							hub = HubState
							local wanted = hub.Steal.Wanted
							if wanted then
								return
							else
								local hub = HubState
								if hub.Steal.Carrying then return end
							end
						end
					end
				end
				move = HubState
				typeVal = move.ClaimMovement("predictor")
				if typeVal then
					move = HubState
					local riding = move.Treadmill.Riding
					if riding then
						pcall(HubState.ExitBelt)
					else
						local hub = HubState
						local onBelt = hub.OnBelt()
						if onBelt then pcall(HubState.ExitBelt) end
					end
					pcall(HubState.FlyTo,isStatusTxt.Position+Vector3.new(0,3,0),function() return false end,"fly")
					riding = HubState
					riding.ReleaseMovement("predictor")
				end
			end)
			flag2 = false
			stepFn()
		end
