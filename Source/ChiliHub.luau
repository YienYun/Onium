	SerializeMcpValue = function(val,depth,seen)
		local depth = depth or 0
		if depth>6 then return "<max-depth>" end
		local typeofVal = typeof(val)
		if typeofVal=="nil" or typeofVal=="boolean" or typeofVal=="string" then
			return val
		elseif typeofVal=="number" then
			if val~=val or val==math.huge or val==-math.huge then return tostring(val) end
			return val
		elseif typeofVal=="Instance" then
			return {_type="Instance",className=val.ClassName,name=val.Name,path=GetInstanceFullPath(val)}
		elseif typeofVal=="Vector3" then
			return {x=val.X,y=val.Y,z=val.Z}
		elseif typeofVal=="Vector2" then
			return {x=val.X,y=val.Y}
		elseif typeofVal=="CFrame" then
			local pos = val.Position
			local look = val.LookVector
			return {position={x=pos.X,y=pos.Y,z=pos.Z},lookVector={x=look.X,y=look.Y,z=look.Z}}
		elseif typeofVal=="Color3" then
			return {r=math.floor(val.R*255+0.5),g=math.floor(val.G*255+0.5),b=math.floor(val.B*255+0.5)}
		elseif typeofVal=="UDim2" then
			return {xScale=val.X.Scale,xOffset=val.X.Offset,yScale=val.Y.Scale,yOffset=val.Y.Offset}
		elseif typeofVal=="UDim" then
			return {scale=val.Scale,offset=val.Offset}
		elseif typeofVal=="EnumItem" then
			return tostring(val)
		elseif typeofVal=="table" then
			seen = seen or {}
			if seen[val] then return "<cycle>" end
			seen[val] = true
			local out = {}
			local count = 0
			for valKey,val in pairs(val) do
				count += 1
				if count>200 then
					out["<truncated>"] = true
					break
				end
				local key = (type(valKey)=="number" or type(valKey)=="string") and valKey or tostring(valKey)
				out[key] = SerializeMcpValue(val,depth+1,seen)
			end
			seen[val] = nil
			return out
		end
		return tostring(val)
	end
