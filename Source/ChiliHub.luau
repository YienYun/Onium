						ok,res=pcall(function() McpWebSocket:Send(jsonBody) end)
						if ok then return true end
						return false,"WebSocket send failed: " .. tostring(res)
					end
					return false,"message too large"
				end
				jsonBody = jsonStr
				ok,res=pcall(function() McpWebSocket:Send(jsonBody) end)
				if ok then return true end
				return false,"WebSocket send failed: " .. tostring(res)
			end
			return false,tostring(jsonStr)
		end
		return false,"not connected"
	end
