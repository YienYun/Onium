					eggRecs = nil
				else
					eggRecs = fieldEggs.Records or nil
				end
			else
				eggRecs = nil
			end
			local directory = cached2.Directory
			if type(eggRecs)~="table" then return stateTbl end
			if type(directory)~="table" then return stateTbl end
			for eggKey,tblVal in pairs(eggRecs) do
				local itemVal
				if type(tblVal)=="table" then
					itemVal = directory[tostring(tblVal.AssetCategory)] or nil
				else
					itemVal = nil
				end
				if type(itemVal)=="table" then
					if type(tblVal.Uid)=="string" then
						if tblVal.State=="Slot" then
							if string.sub(tblVal.Uid,1,12)~="FirstAreaEgg" then
								local numVal = tonumber(tblVal.AssetScale) or 1
								local powScale
								if numVal>5 then
									powScale = (numVal/5)^1.2*19.637875755794113 or numVal^1.85
								else
									powScale = numVal^1.85
								end
								local num = 1
								if type(cached3)=="table" then
									if type(cached3.EarningsFor)=="function" then
										if type(tblVal.Mutations)=="table" then
											local ok,earnings=pcall(cached3.EarningsFor,tblVal.Mutations)
											if ok then if type(earnings)=="number" then if earnings>0 then num = earnings end end end
										end
									end
								end
								local numVal2 = (tonumber(itemVal.EarningRate) or 0)*powScale*num
								if minTelemetryEggValue<=numVal2 then
									local rarity
									if type(itemVal.Rarity)=="table" then
										rarity = itemVal.Rarity or {}
									else
										rarity = {}
									end
									local count = 0
									if type(cached4)=="table" then
										if type(cached4.WeightKgForScale)=="function" then
											local ok,weightKg=pcall(cached4.WeightKgForScale,tblVal.AssetCategory,numVal)
											if ok then if tonumber(weightKg) then count = tonumber(weightKg) end end
										end
									end
									local list = {}
									if type(tblVal.Mutations)=="table" then
										for key,strVal in pairs(tblVal.Mutations) do
											if strVal~=true then
												if type(strVal)=="string" then table.insert(list,strVal) end
											else
												table.insert(list,tostring(key))
											end
										end
									end
									local insert = table.insert
									local uidTbl = {uid=tblVal.Uid,name=tostring(itemVal.DisplayName or tblVal.AssetCategory),rarity=tonumber(rarity.RarityNumber or rarity.Rank) or 0,rarityName=tostring(rarity.DisplayName or rarity._id or ""),value=numVal2,valueText=formatEggValueShort(numVal2),weight=count}
									local textVal
									if count>0 then
										local format = string.format
										local textVal2
										if count>=100 then
											textVal2 = "%.0f kg"
										else
											textVal2 = "%.2f kg"
										end
										textVal = format(textVal2,count) or ""
									else
										textVal = ""
									end
									uidTbl.weightText = textVal
									uidTbl.size = math.floor(numVal*100+0.5)/100
									uidTbl.area = tostring(tblVal.AreaId or "")
									uidTbl.mutation = table.concat(list,", ")
									uidTbl.image = tostring(itemVal.Icon or itemVal.Thumbnail or "")
									insert(stateTbl,uidTbl)
								end
							end
						end
					end
				end
			end
			return stateTbl
		end
		local postEncryptedTelemetry = function(param)
			local stepFn = function()
				pcall(function()
					local jsonBody = httpSvc:JSONEncode({ts=math.floor(workspace:GetServerTimeNow()*1000),token=telemetryCfg.Token,userId=plr.UserId,jobId=game.JobId,placeId=game.PlaceId,eggs=param})
					httpRequestApi({Url=telemetryCfg.Url,Method="POST",Headers={["Content-Type"]="text/plain"},Body=encryptTelemetryFrame(jsonBody)})
				end)
			end
			task.spawn(stepFn)
		end
		local seenSet = {}
		local flag = false
		local flag2 = false
		local flag3 = false
		local count = 0
		local flushEggTelemetryReport = function()
			if flag2 then return end
			if McpIsRunning then
				flag2 = true
				local ok,collectMcp=pcall(collectMcpEggWorldSnapshot)
				if ok then
					if #collectMcp>0 then
						if not (playersSvc.MaxPlayers<=#playersSvc:GetPlayers()) then
							flag = false
							local list = {}
							for idx,uidRef in ipairs(collectMcp) do
								if not seenSet[uidRef.uid] then
									seenSet[uidRef.uid] = true
									table.insert(list,uidRef)
									if #list==10 then
										postEncryptedTelemetry(list)
										list = {}
										task.wait(0.3)
									end
								end
							end
							if #list>0 then postEncryptedTelemetry(list) end
						else
							flag = true
						end
					end
				end
				flag2 = false
				return
			end
		end
		local scheduleEggTelemetryScan = function()
			local now = os.clock()
			if not (now-count<telemetryDebounceSec) then
				count = now
				task.spawn(flushEggTelemetryReport)
				return
			end
			if flag3 then return end
			flag3 = true
			task.delay(0.5,function()
				flag3 = false
				count = os.clock()
				flushEggTelemetryReport()
			end)
		end
		local bindAreaEggSlotSignals = function()
			scheduleEggTelemetryScan()
			task.delay(1.5,scheduleEggTelemetryScan)
		end
		if type(httpRequestApi)~="function" then return end
		local areaEggSlots = workspace:FindFirstChild("AreaEggSlotsClient")
		if areaEggSlots then
			areaEggSlots.ChildAdded:Connect(bindAreaEggSlotSignals)
		else
			local conn = nil
			conn = workspace.ChildAdded:Connect(function(inst)
	if inst.Name~="AreaEggSlotsClient" then return end
	conn:Disconnect()
	inst.ChildAdded:Connect(bindAreaEggSlotSignals)
	bindAreaEggSlotSignals()
end)
		end
		local player = playersSvc.PlayerRemoving
		local player2 = player
		local connect = player.Connect
		local onPlayerRemovingFlush = function()
			if flag then
				task.delay(0.2,scheduleEggTelemetryScan)
				return
			end
		end
		connect(player2,onPlayerRemovingFlush)
		task.defer(scheduleEggTelemetryScan)
	end
	SetupMcpEggTelemetryModule()
	pcall(getgenv().ChilliHubLoadStep,10)
end
