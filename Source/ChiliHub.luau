		local function walkHumanoidToPosition(param,rawNum,rawNum2,fnCallback)
			local rawNum3,rawNum4,count,pos=tonumber(rawNum) or 6,tonumber(rawNum2) or 10,0
			rawNum2,rawNum=0,0
			while count<rawNum4 do
				if type(fnCallback)=="function" then
					if fnCallback() then
						local hub = hub
						hub.StopWalking()
						return false
					end
				end
				local plr = plr
				local char = plr.Character
				local rootPart,hum=char and (char:FindFirstChild("HumanoidRootPart")),char and (char:FindFirstChildOfClass("Humanoid"))
				if rootPart then
					if not hum then
						return false
					elseif hum.Health<=0 then
						return false
					end
				else
					return false
				end
				plr = (rootPart.Position-param).Magnitude
				if plr<=rawNum3 then
					char = hub
					char.StopWalking()
					return true
				end
				rawNum2,pos,rawNum=if pos then if (rootPart.Position-pos).Magnitude<1 then rawNum2+0.2 else 0 else 0,rootPart.Position,math.max(0,rawNum-0.2)
				if rawNum2>=0.8 then
					if rawNum<=0 then
						rootPart,char,plr=0,1.5,hub
						plr.LeaveBelt()
						pcall(function() hum.Jump = true end)
						rawNum2,rawNum=rootPart,char
					else end
				else end
				hum:MoveTo(param)
				count = count+task.wait(0.2)
			end
			rawNum = hub
			rawNum.StopWalking()
			rawNum2 = hub
			return rawNum2.DistanceTo(param)<=rawNum3
		end
