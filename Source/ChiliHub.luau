			for idx = 60, 1, -1 do
				greenRef = math.max(0,idx*recipe.Golden-golden)
				local maxVal = math.max(0,idx*recipe.Purple+(tradeCost.Purple or 50)*greenRef-purple)
				local maxVal2 = math.max(0,idx*recipe.Blue+(tradeCost.Blue or 10)*maxVal-blue)
