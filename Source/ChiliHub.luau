local RefreshLabEggPools = function()
	local slot
	local hub = HubState
	local lab = hub.Lab
	local ok,requireVal=pcall(function()
	local slot
	local replicated = ReplicatedStorageService
	return require(replicated.Shared.Modules.ScrambleTradeInRecipes)
end)
	if ok then
		if type(requireVal)~="table" then
			return
		elseif type(requireVal.Simulate)~="function" then
			return
		end
	else
		return
	end
	local httpSvc,mapTbl=game:GetService("HttpService"),{}
	pcall(function()
		local hasFile = isfile(lab.ExtraPath)
		if hasFile then
			local decoded = httpSvc:JSONDecode(readfile(lab.ExtraPath))
			local isTable = type(decoded)=="table"
			if isTable then mapTbl = decoded end
		end
	end)
	local pairsFn,shares,flag=pairs,lab.Shares,false
	for shareKey,list in pairsFn(shares) do
		hub,ok=pcall(requireVal.Simulate,shareKey,4000)
		if hub then
			local isTable = type(ok)=="table"
			if isTable then
				local isTable = type(ok.SlotPicks)=="table"
				if isTable then
					local maxVal,labelsFor=math.max(1,tonumber(ok.Runs) or 4000),{}
					for key,slotPick in pairs(ok.SlotPicks) do
						if type(slotPick)=="table" then
							for key2,rawNum in pairs(slotPick) do
								key = tostring(key2)
								labelsFor[key] = (labelsFor[key] or 0)+(tonumber(rawNum) or 0)
							end
						end
					end
					local count,count2=0,0
					for key,labelsFor in pairs(labelsFor) do
						if labelsFor>0 then
							count,count2=count+labelsFor,count2+1
						else end
					end
					if count<maxVal then
						task.wait()
						continue
					elseif count2<math.min(8,#list) then
						task.wait()
						continue
					end
					local map,itemVal,list2,flag2=type(mapTbl[shareKey])=="table" and mapTbl[shareKey] or {},{},{},false
					for idx,list in ipairs(list) do
						local itemVal2,itemVal3=list[1],list[2]
						if (labelsFor[itemVal2] or 0)>0 or itemVal3<0.02 then
							itemVal[itemVal2] = true
							table.insert(list2,{itemVal2,itemVal3})
						else
							flag2 = true
						end
					end
					local flag3 = flag
					for key,labelsFor in pairs(labelsFor) do
						local itemVal = itemVal[key]
						if itemVal then
						else
							local isLabelsFor = labelsFor>0
							if isLabelsFor then
								local numVal = tonumber(map[key])
								if numVal then
								else
									numVal = math.max(0.001,math.floor(labelsFor/maxVal*1000+0.5)/1000)
									map[key] = numVal
									mapTbl[shareKey] = map
									local active = true
									flag3 = active
								end
								table.insert(list2,{key,numVal})
								local active = true
								flag2 = active
							else end
						end
					end
					if flag2 then
						table.sort(list2,function(mapTbl,mapTbl2)
							if mapTbl[2]~=mapTbl2[2] then return mapTbl[2]>mapTbl2[2] end
							return mapTbl[1]<mapTbl2[1]
						end)
						lab.Shares[shareKey] = list2
						lab.Pools[shareKey] = nil
						lab.PoolLists[shareKey] = nil
						itemVal = lab.Pickers[shareKey]
						if itemVal then
							if itemVal.Handle then
								if type(itemVal.Handle.SetOptions)=="function" then
									if type(lab.LabelsFor)=="function" then
										maxVal,labelsFor=lab.LabelsFor(shareKey)
										if #maxVal>0 then
											itemVal.CategoryOf = labelsFor
											pcall(itemVal.Handle.SetOptions,itemVal.Handle,maxVal,nil,true)
										end
									end
								end
							end
						end
					end
					flag = flag3
				else end
			else end
		else end
		task.wait()
	end
	task.delay(0.3,function() pcall(HubState.Lab.FixPickers) end)
	if flag then
		hub = type(writefile)=="function"
		if hub then
			pcall(function()
				if type(isfolder)=="function" then
					if type(makefolder)=="function" then if not (isfolder("ChilliLibrary")) then makefolder("ChilliLibrary") end end
				end
				writefile(lab.ExtraPath,httpSvc:JSONEncode(mapTbl))
			end)
		end
	end
end
