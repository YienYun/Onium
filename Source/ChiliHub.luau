	local function solveBanjoNoteSequence(param,inTreeRef)
		handleTbl.Solved = false
		handleTbl.Notes = nil
		handleTbl.LastAt = 0
		local endAt,count=os.clock()+300,0
		while os.clock()<endAt do
			if checkLoop(param) then
				return false
			elseif inTreeRef.InTree() then
				if not (checkDistance()) then return false end
			else
				return false
			end
			if handleTbl.Solved then
				return true
			elseif stepFn().Solved==true then
				return true
			end
			local notes = handleTbl.Notes
			if notes==nil then
				if os.clock()-handleTbl.LastAt>4 then
					count += 1
					if count>12 then
						handleTbl.Status = "The mushrooms do not answer"
						handleTbl.NextTry = os.clock()+30
						return false
					end
					handleTbl.Status = "Waking the mushrooms"
					setStatus(4,param)
					handleTbl.LastAt = os.clock()
				else end
				task.wait(0.1)
			elseif os.clock()<handleTbl.ListenAt then
				handleTbl.Status = string.format("Stage %d/%d, listening to %d notes",(handleTbl.Cleared or 0)+1,stepFn2(),#notes)
				task.wait(0.05)
			else
				handleTbl.Notes = nil
				local cleared = (handleTbl.Cleared or 0)+1
				for idx,note in ipairs(notes) do
					if checkLoop(param) then return false end
					handleTbl.Status = string.format("Stage %d/%d, note %d/%d",cleared,stepFn2(),idx,#notes)
					idx = nil
					for idx2 = 1, 2, 1 do
						idx2 = os.clock()
						if not (setStatus(note,param)) then break end
						idx = runClock(note,idx2,1.6)
						if idx then break end
					end
					if idx~="ok" then
						handleTbl.Status = "Missed a note, starting over"
						break
					end
				end
				handleTbl.LastAt = os.clock()
				count = 0
			end
		end
		return false
	end
