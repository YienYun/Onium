		local function readKeypoints(keypointsRef,secArg)
			local keypoints = keypointsRef.Keypoints
			if secArg<=keypoints[1].Time then return keypoints[1].Value end
			for idx = 2, #keypoints, 1 do
				local keypoint,keypoint2=keypoints[idx-1],keypoints[idx]
				if secArg<=keypoint2.Time then
					keypointsRef = keypoint2.Time-keypoint.Time
					idx = keypointsRef>0 and (secArg-keypoint.Time)/keypointsRef or 0
					return keypoint.Value:Lerp(keypoint2.Value,idx)
				end
			end
			return keypoints[#keypoints].Value
		end
